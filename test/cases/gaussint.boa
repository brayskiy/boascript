// Numerical integration in BoaScript: 3-point Gauss-Legendre quadrature,
// written as a user function that calls another user function (the
// integrand f). Modeled on the ooyacc intgauss3 example.
//
// 3-point Gauss-Legendre on [-1,1]: nodes +/-sqrt(3/5), 0 with weights
// 5/9, 8/9, 5/9; mapped to [a,b] via x = h*xi + c. Exact for polynomials
// up to degree 5.

setprec(6);

func gaussint(a, b) {
    h = (b - a) / 2;
    c = (a + b) / 2;
    s = sqrt(0.6);
    return h * (5.0 / 9.0 * f(c - h * s)
              + 8.0 / 9.0 * f(c)
              + 5.0 / 9.0 * f(c + h * s));
}

// Integral of x^2 over [0,1] = 1/3 (exact for this method).
func f(x) { return x * x; }
println gaussint(0, 1);      // 0.333333

// Integral of 3x^2 + 2x + 1 over [0,1] = 3 (exact).
func f(x) { return 3 * x * x + 2 * x + 1; }
println gaussint(0, 1);      // 3.000000

// Integral of x^3 over [0,2] = 4 (exact).
func f(x) { return x * x * x; }
println gaussint(0, 2);      // 4.000000

// Integral of sin(x) over [0,pi] ~= 2 (3-point approximation).
func f(x) { return sin(x); }
println gaussint(0, pi());   // 2.001389
