// Math builtins at a fixed precision for stable output.
setprec(4);
println sqrt(2);      // 1.4142
println cbrt(27);     // 3.0000
println pow(2, 10);   // 1024.0000
println exp(0);       // 1.0000
println log(1);       // 0.0000
println log10(1000);  // 3.0000
println abs(-7);      // 7.0000
println floor(3.7);   // 3.0000
println ceil(3.2);    // 4.0000
println min(3, 8);    // 3.0000
println max(3, 8);    // 8.0000
println sin(0);       // 0.0000
println cos(0);       // 1.0000
